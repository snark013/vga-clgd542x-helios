			)
			(justify left bottom)
		)
	)
	(gr_text ".                                                       .\n JP5 - use IRQ2 (Default - Open)\n JP6 - zero WS ISA (Default - Close)\n JP7 - ROM section select\n JP8,9 - use MEMR/EROM/GND as ROM read signal\n           (default - EROM)\n \n U1 - 512 KB (5422-5424)\n +U2 - 1 MB (5422-5429)\n +U3, U4 - 2 MB (5426-5429)\n\n R9-R14 - configuration resistors:\n R9 - zero WS BIOS (ex. 5429)\n R10 - 3C3/4E68 sleep (np)\n R11, 12 - DRAM speed (50/44/41/38Mhz)\n R13 - DRAM timing\n R14 - DRAM multi CAS/WE (must)\n default - set all except R10 (and R9 for 5429)\n.                                                       ."
		(at 220.44 62.63 0)
		(layer "B.SilkS")
		(uuid "19eb0701-89b2-4a57-aa0f-cf929c9e5dae")
		(effects
			(font
				(size 0.8 0.8)
				(thickness 0.16)
				(bold yes)
			)
			(justify left mirror)
		)
	)
