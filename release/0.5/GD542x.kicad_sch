	(text "Config Resistors \nR101 (MD17) - 0 - zero wait enable, 1 - zero wait disable\nR102 (MD19) - port 3C3h/46E8h (0/1) is Video Sleep register\nR104, 103 (MD2. 25) - DRAM speed (00 - 50MHz, 01 - 44MHz, 10 - 41Mhz, 11 - 38NHz)\nR105 (MD27) - DRAM timing high/normal (0/1) performance\nR106 (MD28) - DRAM mode - multi CAS/WE (0/1)\nR107 (MD29) - DRAM type - asymmetric/symmetric (0/1)"
		(exclude_from_sim no)
		(at 204.47 135.255 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "3f98f744-188e-4ff1-8a4c-611faaed4611")
	)
