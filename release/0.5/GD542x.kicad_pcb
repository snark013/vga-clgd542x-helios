	(gr_text ".                                                  .\n JP1 - ROM section select\n JP2 - Zero WS\n JP3, 8 - use MEMR/EROM as ROM read signal\n JP9 - use IRQ2\n\n U2 - 512 KB (5420-5424)\n +U1 - 1 MB (5422-5429)\n +U7, U8 - 2 MB (5426-5429) - R106, 107 on \n\n R101-R107 - configuration resistors.\n R101 - 0ws BIOS\n R102 - 3C3/4E68 sleep (np)\n R103, 104 - DRAM speed\n R105 - DRAM timing\n R106 - DRAM multi CAS/WE\n R107 - DRAM symmetric/asymmetric\n (default - set all except R102)\n.                                                  ."
		(at 220.3196 62.0776 0)
		(layer "B.SilkS")
		(uuid "19eb0701-89b2-4a57-aa0f-cf929c9e5dae")
